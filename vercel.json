{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bainsquared.com"
        }
      ],
      "destination": "https://www.bainsquared.com/:path*",
      "permanent": true
    },
    {
      "source": "/insights/agentic-ai-pilots-pay-off",
      "destination": "/insights/agentic-ai-launch-checklist",
      "permanent": true
    },
    {
      "source": "/insights/rewiring-fpa",
      "destination": "/what-we-do/financial-transformation",
      "permanent": true
    },
    {
      "source": "/insights/intangibles-90-percent",
      "destination": "/what-we-do/intangibles-valuation",
      "permanent": true
    },
    {
      "source": "/insights/the-squared-method",
      "destination": "/what-we-do",
      "permanent": true
    },
    {
      "source": "/ai-integration",
      "destination": "/what-we-do/agentic-ai-automation",
      "permanent": true
    },
    {
      "source": "/financial-transformation",
      "destination": "/what-we-do/financial-transformation",
      "permanent": true
    },
    {
      "source": "/intangibles-valuation",
      "destination": "/what-we-do/intangibles-valuation",
      "permanent": true
    },
    {
      "source": "/explore-careers",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/categories/perspectives",
      "destination": "/insights/perspectives",
      "permanent": true
    },
    {
      "source": "/blog/categories/valuation",
      "destination": "/insights/topics/intangibles-valuation",
      "permanent": true
    },
    {
      "source": "/blog/categories/artificial-intelligence",
      "destination": "/insights/topics/ai",
      "permanent": true
    },
    {
      "source": "/blog/categories/case-study",
      "destination": "/insights/client-stories",
      "permanent": true
    },
    {
      "source": "/blog/categories/project-operations",
      "destination": "/insights/field-notes",
      "permanent": true
    },
    {
      "source": "/blog/categories/user-experience",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/categories/financial-transformation",
      "destination": "/insights/topics/financial-transformation",
      "permanent": true
    },
    {
      "source": "/blog/categories/squared-reports",
      "destination": "/insights/squared-reports",
      "permanent": true
    },
    {
      "source": "/blog/categories/emerging-tech",
      "destination": "/insights/looking-glass",
      "permanent": true
    },
    {
      "source": "/blog/categories/inside-bain-squared-hq",
      "destination": "/insights/inside-hq",
      "permanent": true
    }
  ]
}
